# 复制成 .env 再填。真实环境变量优先级高于本文件，所以部署时也可以直接 export。
# 必须填的只有四项：QQ_APP_ID / QQ_APP_SECRET / AI_PROVIDER / 对应供应商的 Key。
# 剩下的全部有默认值，不填也能跑；但 OWNER_CLAIM_PHRASE 强烈建议改掉（见下）。

# ── 机器人凭证（QQ 开放平台 → 开发设置）──
QQ_APP_ID=
QQ_APP_SECRET=

# ── 认主暗号：私聊机器人发这一句，第一个说对的人被永久写进 owner.txt ──
# 默认是「认主」，但那是公开的，部署前务必改成只有你知道的一句。
# 认领只在私聊里生效；群里说破天也不授权（群聊是大声公，谁先喊谁得）。
# 留空 = 关掉私聊认领通道（想走「先删 owner.txt 再重启」的手动流程时可以这么干）。
OWNER_CLAIM_PHRASE=认主

# ── 主供应商：用哪家就把它设成哪家，下面只填那一家的 Key（另一把可以空着）──
# gemini：快（插嘴请求 1.1~1.7s），但国内要代理；免费层给 3.5-flash-lite 500 次/天
# zhipu ：直连稳，质量好但慢（同请求 4.7s）；有隐式前缀缓存，重复前缀命中率 99%
AI_PROVIDER=gemini
GEMINI_API_KEY=
ZHIPU_API_KEY=

# ── 备用供应商：主供应商整条链路不通时自动接管，留空 = 不降级 ──
FALLBACK_PROVIDER=zhipu

# ── 触发词：机器人在这群里被叫到的名字（可多个别名，逗号分隔）──
# 部署时**最该先改的一处**：不配它，机器人在群里就是个哑巴 —— 喊它不应、也不主动接话，
# 而且不报错。这一串同时管三件事：识别「是不是在叫它」、剥掉喊人前缀、提示词里的自称。
# 不给默认值是有意的：代码里出现具体人名就没法换个群用、也没法开源。
# 留空则只认平台昵称（你在 QQ 那边定的机器人名字，进程一起来就知道）。
# 举例（改成你们群里的叫法）：
#   BOT_NAMES=阿黄,小黄
BOT_NAMES=

# ── 需要代理才能连上 Gemini 的网络，把下面两行取消注释并改成自己的端口 ──
# 智谱是直连的，所以必须把 bigmodel.cn 加进 NO_PROXY，否则它的流量也会绕代理。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=bigmodel.cn,open.bigmodel.cn

# ── 想调再动，都是频率/额度类的旋钮（下面给的是默认值）──
# BANTER_PROBABILITY=0.08          # 主动插嘴概率，8% ≈ 每天 7 次
# OWNER_MENTION_PROBABILITY=0.25   # 聊到群主时的插嘴概率
# BANTER_COOLDOWN_SECONDS=120
# DAILY_BUDGET=3000                # 全局每日调用上限，兜底防账单
# PROVIDER_CACHE_WARM_SECONDS=600  # 让位后等群静多久才切回主供应商
# LOG_LEVEL=INFO
