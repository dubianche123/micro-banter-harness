<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.qqbot.keepawake</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/a0000/code_repository/QQbot/tools/launchd/keepawake.sh</string>
    </array>

    <!-- 每 5 分钟巡一次：补挂了的 caffeinate、兜底把 bot 拉回来 -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/a0000/Library/Logs/com.qqbot.keepawake.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/a0000/Library/Logs/com.qqbot.keepawake.log</string>
</dict>
</plist>
